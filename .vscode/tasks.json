{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start NovaShop",
			"type": "shell",
			"command": "npm start",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run project checks",
			"type": "shell",
			"command": "npm run check",
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Run NovaShop tests",
			"type": "shell",
			"command": "npm test",
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Start NovaShop with accounts",
			"type": "shell",
			"command": "npm start",
			"options": {
				"env": {
					"PORT": "3001"
				}
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Commit Render deployment setup",
			"type": "shell",
			"command": "git add render.yaml README.md server.js .vscode/tasks.json; if ($?) { git diff --cached --check }; if ($?) { git commit -F .git-commit-message.tmp }",
			"isBackground": false,
			"problemMatcher": []
		}
	]
}